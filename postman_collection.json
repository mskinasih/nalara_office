{
    "info": {
        "name": "Nalara Backend API",
        "description": "API endpoints for the Nalara Backend application",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://nalaraoffice.vercel.app",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Students",
            "item": [
                {
                    "name": "Get All Students",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/students",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "students"]
                        }
                    }
                },
                {
                    "name": "Create Student",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe\",\n  \"jenjang\": \"smp\",\n  \"type\": \"private\",\n  \"kelas\": \"9\",\n  \"isLongDistance\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/students",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "students"]
                        }
                    }
                },
                {
                    "name": "Update Student",
                    "request": {
                        "method": "PUT",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe Updated\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/students/REPLACE_WITH_STUDENT_ID",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "students", "REPLACE_WITH_STUDENT_ID"]
                        }
                    }
                },
                {
                    "name": "Delete Student",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/api/students/REPLACE_WITH_STUDENT_ID",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "students", "REPLACE_WITH_STUDENT_ID"]
                        }
                    }
                }
            ]
        },
